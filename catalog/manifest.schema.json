{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": ["version", "schemaVersion", "files"],
	"properties": {
		"version": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}(\\.[0-9]+)?$" },
		"schemaVersion": { "type": "integer", "minimum": 1 },
		"files": {
			"type": "object",
			"additionalProperties": false,
			"required": ["categories.json", "products.json", "barcode_formats.json"],
			"properties": {
				"categories.json": { "$ref": "#/$defs/sha256" },
				"products.json": { "$ref": "#/$defs/sha256" },
				"barcode_formats.json": { "$ref": "#/$defs/sha256" }
			}
		}
	},
	"$defs": {
		"sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
	}
}