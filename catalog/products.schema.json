{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "array",
	"items": {
		"type": "object",
		"additionalProperties": false,
		"required": [
			"key", "categoryKey", "manufacturer", "name", "gtin", "containsProductKey",
			"containsQty", "ratedWearDays", "minSamples", "expiryRule", "expiryStrictness",
			"sourceUrl", "verified"
		],
		"properties": {
			"key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,99}$" },
			"categoryKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
			"manufacturer": { "type": "string", "minLength": 1, "maxLength": 120 },
			"name": { "type": "string", "minLength": 1, "maxLength": 160 },
			"gtin": { "type": ["string", "null"], "pattern": "^[0-9]{14}$" },
			"containsProductKey": { "type": ["string", "null"] },
			"containsQty": { "type": ["integer", "null"], "minimum": 1, "maximum": 10000 },
			"ratedWearDays": { "type": ["integer", "null"], "minimum": 1, "maximum": 365 },
			"minSamples": { "type": "integer", "minimum": 1, "maximum": 100 },
			"expiryRule": { "enum": ["finish_by", "start_by", "none"] },
			"expiryStrictness": { "enum": ["hard", "soft"] },
			"sourceUrl": { "type": "string", "pattern": "^https?://\\S+$", "maxLength": 2048 },
			"verified": { "type": "boolean" }
		},
		"allOf": [
			{
				"if": { "properties": { "containsProductKey": { "type": "string" } } },
				"then": { "properties": { "containsQty": { "type": "integer", "minimum": 1 } } }
			},
			{
				"if": { "properties": { "containsProductKey": { "type": "null" } } },
				"then": { "properties": { "containsQty": { "type": ["integer", "null"] } } }
			}
		]
	}
}